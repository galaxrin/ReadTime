{
  "appId": "com.readtime.app",
  "productName": "ReadTime",
  "mac": {
    "icon": "assets/readtime-logo.png",
    "category": "public.app-category.utilities",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ]
  },
  "win": {
    "icon": "assets/readtime-logo.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/fonts/**/*",
    "assets/tray/trayTemplate*.png",
    "package.json"
  ]
}
