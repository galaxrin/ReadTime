{
  "name": "readtime",
  "version": "1.0.1",
  "description": "Discreet reading app for Mac",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.json --noEmit && vite build && ./fix-build.sh",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --mac",
    "pack": "npm run build && electron-builder --dir",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^28.3.3",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.7.3",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "vite": "^5.4.14"
  }
}
